# Copy to .env before `docker compose up`.
# Compose interpolates these values. The API container does not receive OLLAMA_* .

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-coder:30b
OLLAMA_TIMEOUT_MS=180000
EXPLANATION_PACKET_CHAR_BUDGET=32000

DATABASE_URL=postgresql+psycopg://pr_explain:pr_explain@localhost:5432/pr_explain
POSTGRES_USER=pr_explain
POSTGRES_PASSWORD=pr_explain
POSTGRES_DB=pr_explain

GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Prefer the downloaded PEM. Compose mounts it and sets the container path:
# GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github-app.pem
# - /path/to/app.private-key.pem:/run/secrets/github-app.pem:ro
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_URL=https://api.github.com

# Public origin of the React app. The pull-request comment footer uses this.
APP_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

FANOUT_CAP=50
MAX_CHANGED_SYMBOLS=80
RUN_MIGRATIONS=true
