# Copy to .env before `docker compose up`.
# Compose interpolates these values. The API container does not receive OLLAMA_* .
# LLM_API_KEY stays in .env. Do not commit .env.

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-coder:30b
OLLAMA_TIMEOUT_MS=180000

# OpenAI-compatible chat. Used only when LLM_PROVIDER=openai.
# Example LLM_BASE_URL: https://api.openai.com/v1
# Leave these empty for the local Ollama default.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

EXPLANATION_PACKET_CHAR_BUDGET=32000

DATABASE_URL=postgresql+psycopg://pr_explain:pr_explain@localhost:5432/pr_explain
POSTGRES_USER=pr_explain
POSTGRES_PASSWORD=pr_explain
POSTGRES_DB=pr_explain

GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Host path of the .pem downloaded from the GitHub App settings page.
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_URL=https://api.github.com

# Public origin of the React app. The pull-request comment footer uses this.
APP_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

FANOUT_CAP=50
MAX_CHANGED_SYMBOLS=80
RUN_MIGRATIONS=true
